PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pd_crm

# CRM Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# JWT secret — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Social lead webhooks — not wired to a real integration yet, these are just
