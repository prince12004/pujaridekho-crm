# META_WEBHOOK_VERIFY_TOKEN=set-this-when-registering-the-webhook-in-meta-app-dashboard
# META_APP_SECRET=needed-later-to-verify-X-Hub-Signature-256-once-a-real-Meta-app-exists
# WHATSAPP_APP_SECRET=needed-later-to-verify-WhatsApp-Business-Cloud-API-signatures
